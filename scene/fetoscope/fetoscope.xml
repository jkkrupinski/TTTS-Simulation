<mujoco model="fetoscope">

	<option timestep="0.0001" integrator="RK4" >
		<flag energy="enable" contact="enable" />
	</option>

	<worldbody>

		<body pos="0 0 0.25" euler="0 3.141592654 0">
		  	<joint name="x" type="hinge" axis="1 0 0" pos ="0 0 -0.16"/>
			<joint name="y" type="hinge" axis="0 1 0" pos ="0 0 -0.16"/>

			<geom type="cylinder" size="0.003 0.15" rgba="0.9 .9 0.9 1" mass="1"/>
			<camera name="eye" mode="fixed" pos="0 0 0" euler='0 3.141592654 0' fovy="5"/>
			<light specular=".1 .1 .1" pos="0 0 0.15" dir="0 0 1" />

		</body>

	</worldbody>

	<actuator>
		<position name="x_axis" joint="x" kp="1" kv="1"/>
		<position name="y_axis" joint="y" kp="1" kv="1"/>

	</actuator>
    
</mujoco>